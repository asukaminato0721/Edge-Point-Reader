{
	"name": "edge-point-reader",
	"main": "read-clipboard-edge-tts.js",
	"compatibility_date": "2026-08-20",
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"logs": {
			"enabled": true
		},
		"traces": {
			"enabled": true
		}
	}
	// Set the semantic API URL and model in the userscript menu.
	// Configure API_TOKEN to authenticate callers that choose the AI endpoint.
	// Store SEMANTIC_API_TOKEN with: npx wrangler secret put SEMANTIC_API_TOKEN
}
